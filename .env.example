# Copy this file to .env and fill in real values. .env is gitignored.

# Required — Supabase project credentials (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-ANON-OR-SERVICE-KEY

# Optional — email
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (fredbeans-reporting.com).
RESEND_FROM_EMAIL=recallchecks@fredbeans-reporting.com

# Optional — GitHub Actions fallback (only needed in prod where Ford blocks the host IP)
USE_GH_ACTIONS_FOR_RECALLS=
GH_ACTIONS_TOKEN=
GH_ACTIONS_REPO=CGilbert23/FordRecallCheckScript
GH_ACTIONS_WORKFLOW=recall_check_on_demand.yml
GH_ACTIONS_REF=main
